class Solution {
public:
    int minimumDistance(vector<int>& nums) {
        int found = 0;
        int n1 = 0;
        int n2 = 0;
        int n3 = 0;
        int ans = INT_MAX;
        unordered_map<int, int> arr;
        for (int i = 0; i < nums.size(); i++)
        {
            arr[nums[i]]++;
        }
        for (auto it : arr)
        {
            if (it.second >= 3)
            {
                found = it.first;
                int count = 0;
                for (int i = 0; i < nums.size(); i++)
                {
                    if (nums[i] == found)
                    {
                        if (count == 0)
                        {
                            n1 = i;
                        }
                        else if (count == 1)
                        {
                            n2 = i;
                        }
                        else if (count == 2)
                        {
                            n3 = i;
                            break;
                        }

                        count++;
                    }
                }
                int distance = abs(n1 - n2) + abs(n2 - n3) + abs(n3 - n1);
                ans = min(ans, distance);
            }
        }
        if (ans == INT_MAX)
        {
            return -1;
        }

        return ans;
    }
};

